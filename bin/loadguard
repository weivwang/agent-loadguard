#!/usr/bin/env python3
"""loadguard: keep parallel coding agents from exhausting one machine's memory.

  loadguard run [--max-wait SECONDS] -- COMMAND [ARGS...]
  loadguard status
  loadguard check COMMAND        # would the hook treat COMMAND as heavy?
  loadguard hook                 # Claude Code PreToolUse hook (JSON on stdin)

Heavy commands (test suites, builds, type checks) wait for one of a few
machine-wide slots, start only while enough memory is free, and are stopped
together with every process they spawned once they grow past a ceiling.
Python 3.9+ standard library only; macOS and Linux.
"""

import ctypes
import ctypes.util
import fcntl
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time

VERSION = "0.1.0"

EXIT_KILLED = 99
EXIT_QUEUE_TIMEOUT = 75  # EX_TEMPFAIL
EXIT_USAGE = 64  # EX_USAGE

GIB = 1024 ** 3
POLL_SECONDS = 1.0
WAIT_REPORT_SECONDS = 30
TERM_GRACE_SECONDS = 5
DEFAULT_MAX_WAIT_SECONDS = 1800
GIB_PER_DEFAULT_SLOT = 32
# Under memory panic, only a command at least this share of RAM is worth stopping:
# killing a small one frees too little to save the machine.
PANIC_MIN_SHARE = 0.10
ACTIVE_ENV = "LOADGUARD_ACTIVE"


def fail(message, code=EXIT_USAGE):
    sys.stderr.write("loadguard: %s\n" % message)
    sys.exit(code)


def fmt_gb(n_bytes):
    return "%.1f GB" % (n_bytes / GIB)


def fmt_duration(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm%02ds" % (seconds // 60, seconds % 60)
    return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60)


# --------------------------------------------------------------------------- memory


IS_MAC = sys.platform == "darwin"

if IS_MAC:
    _libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    _libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)

    class _RusageInfoV0(ctypes.Structure):
        _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
            (name, ctypes.c_uint64)
            for name in (
                "user_time",
                "system_time",
                "pkg_idle_wkups",
                "interrupt_wkups",
                "pageins",
                "wired_size",
                "resident_size",
                "phys_footprint",
                "proc_start_abstime",
                "proc_exit_abstime",
            )
        ]

    def _sysctl(name, ctype):
        value = ctype(0)
        size = ctypes.c_size_t(ctypes.sizeof(value))
        if _libc.sysctlbyname(name.encode(), ctypes.byref(value), ctypes.byref(size), None, 0):
            raise OSError(ctypes.get_errno(), "sysctl %s failed" % name)
        return value.value

    def total_memory():
        return _sysctl("hw.memsize", ctypes.c_uint64)

    def available_percent():
        # The kernel's own "memory free percentage" (what `memory_pressure` prints):
        # it counts reclaimable pages, unlike vm_stat's free count.
        return float(_sysctl("kern.memorystatus_level", ctypes.c_int))

    def process_memory(pid):
        # phys_footprint is what Activity Monitor calls "Memory": it includes
        # compressed pages, which RSS hides exactly when a process runs away.
        info = _RusageInfoV0()
        if _libproc.proc_pid_rusage(pid, 0, ctypes.byref(info)) != 0:
            return 0
        return info.phys_footprint

else:

    def _meminfo():
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0]) * 1024
        return values

    def total_memory():
        return _meminfo()["MemTotal"]

    def available_percent():
        info = _meminfo()
        return 100.0 * info["MemAvailable"] / info["MemTotal"]

    def process_memory(pid):
        total = 0
        try:
            with open("/proc/%d/status" % pid) as handle:
                for line in handle:
                    if line.startswith(("VmRSS:", "VmSwap:")):
                        total += int(line.split()[1]) * 1024
        except OSError:
            return 0
        return total


def process_table():
    """pid -> (ppid, pgid, command path) for every process."""
    out = subprocess.run(
        ["ps", "-A", "-o", "pid=,ppid=,pgid=,comm="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        universal_newlines=True,
        check=True,
    ).stdout
    table = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3:
            continue
        table[int(parts[0])] = (int(parts[1]), int(parts[2]), parts[3] if len(parts) > 3 else "")
    return table


def app_name(command_path):
    """Group helper processes under their app: '/Applications/X.app/.../Helper' -> 'X'."""
    match = re.search(r"([^/]+)\.app/", command_path)
    if match:
        return match.group(1)
    return os.path.basename(command_path) or "?"


def largest_apps(limit=3):
    totals = {}
    for pid, (_, _, command) in process_table().items():
        used = process_memory(pid)
        if used:
            name = app_name(command)
            totals[name] = totals.get(name, 0) + used
    ranked = sorted(totals.items(), key=lambda item: -item[1])[:limit]
    return " · ".join("%s %s" % (name, fmt_gb(used)) for name, used in ranked)


# ----------------------------------------------------------------------- settings


def _env_number(name, default):
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        return float(raw)
    except ValueError:
        fail("%s=%r is not a number" % (name, raw))


class Settings:
    def __init__(self):
        self.total = total_memory()
        default_slots = max(1, int(self.total / GIB) // GIB_PER_DEFAULT_SLOT)
        self.slots = max(1, int(_env_number("LOADGUARD_SLOTS", default_slots)))
        self.tree_cap = _env_number("LOADGUARD_TREE_CAP_GB", self.total / GIB / 2) * GIB
        self.min_free_pct = _env_number("LOADGUARD_MIN_FREE_PCT", 20)
        self.panic_free_pct = _env_number("LOADGUARD_PANIC_FREE_PCT", 8)
        root = os.environ.get("LOADGUARD_STATE_DIR") or os.path.join(
            os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "loadguard"
        )
        os.makedirs(root, exist_ok=True)
        self.state_dir = root

    def path(self, name):
        return os.path.join(self.state_dir, name)


def write_json(path, data):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as handle:
        json.dump(data, handle)
    os.replace(tmp, path)


def read_records(settings, prefix):
    """Status records of live loadguard processes; stale files are removed."""
    records = []
    for name in sorted(os.listdir(settings.state_dir)):
        if not (name.startswith(prefix) and name.endswith(".json")):
            continue
        path = settings.path(name)
        try:
            with open(path) as handle:
                record = json.load(handle)
            os.kill(record["pid"], 0)
        except (OSError, ValueError, KeyError):
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        records.append(record)
    return records


# ---------------------------------------------------------------------- the tree


class Tree:
    """Every process a command spawned, including ones that detached from it."""

    def __init__(self, root):
        self.root = root
        self.members = {}  # pid -> command path when first seen (guards against pid reuse)

    def refresh(self):
        table = process_table()
        for pid, command in list(self.members.items()):
            if pid not in table or table[pid][2] != command:
                del self.members[pid]
        children = {}
        for pid, (ppid, pgid, _) in table.items():
            children.setdefault(ppid, []).append(pid)
        stack = [self.root] + list(self.members)
        stack += [pid for pid, (_, pgid, _) in table.items() if pgid == self.root]
        seen = set()
        me = os.getpid()
        while stack:
            pid = stack.pop()
            if pid in seen or pid not in table or pid <= 1 or pid == me:
                continue
            seen.add(pid)
            self.members.setdefault(pid, table[pid][2])
            stack.extend(children.get(pid, ()))

    def memory(self):
        return sum(process_memory(pid) for pid in self.members)

    def kill(self):
        """SIGTERM the whole tree, SIGKILL what is left after a grace period."""
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(self.root, sig)
            except OSError:
                pass
            for pid in list(self.members):
                try:
                    os.kill(pid, sig)
                except OSError:
                    pass
            if sig == signal.SIGKILL:
                break
            deadline = time.monotonic() + TERM_GRACE_SECONDS
            while time.monotonic() < deadline:
                _reap()
                self.refresh()
                if not self.members:
                    return
                time.sleep(0.2)
        _reap()
        self.refresh()


def _reap():
    try:
        while os.waitpid(-1, os.WNOHANG)[0]:
            pass
    except ChildProcessError:
        pass


# ------------------------------------------------------------------------- run


class Stop(Exception):
    pass


def _on_signal(signum, _frame):
    raise Stop(signum)


def try_acquire(settings):
    for index in range(settings.slots):
        handle = open(settings.path("slot-%d.lock" % index), "a+")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            handle.close()
            continue
        return index, handle  # the open handle IS the lease; the OS drops it if we die
    return None


def describe(record):
    return "%s (%s, %s, in %s)" % (
        record["command"],
        fmt_gb(record.get("tree_bytes", 0)),
        fmt_duration(time.time() - record["started"]),
        record["cwd"],
    )


def wait_for_slot(settings, command_text, max_wait):
    started = time.monotonic()
    last_report = None
    waiter_path = settings.path("wait-%d.json" % os.getpid())
    write_json(
        waiter_path,
        {"pid": os.getpid(), "command": command_text, "cwd": os.getcwd(), "started": time.time()},
    )
    try:
        while True:
            available = available_percent()
            if available >= settings.min_free_pct:
                lease = try_acquire(settings)
                if lease:
                    return lease
                holders = read_records(settings, "slot-")
                why = "all %d slot(s) are busy: %s" % (
                    settings.slots,
                    "; ".join(describe(r) for r in holders) or "starting up",
                )
            else:
                why = "only %.0f%% of memory is available (starts at %.0f%%); largest: %s" % (
                    available,
                    settings.min_free_pct,
                    largest_apps(),
                )
            waited = time.monotonic() - started
            if waited >= max_wait:
                fail(
                    "gave up after waiting %s: %s. Nothing was run." % (fmt_duration(waited), why),
                    EXIT_QUEUE_TIMEOUT,
                )
            now = time.monotonic()
            if last_report is None or now - last_report >= WAIT_REPORT_SECONDS:
                sys.stderr.write("loadguard: waiting (%s) — %s\n" % (fmt_duration(waited), why))
                sys.stderr.flush()
                last_report = now
            time.sleep(POLL_SECONDS)
    finally:
        try:
            os.unlink(waiter_path)
        except OSError:
            pass


def largest_guarded(settings, used):
    others = [r.get("tree_bytes", 0) for r in read_records(settings, "slot-") if r["pid"] != os.getpid()]
    return all(used >= other for other in others)


def kill_reason(settings, used, read_available, is_largest):
    """Why a guarded command using `used` bytes must be stopped now, or None.

    `read_available` and `is_largest` are callables so the cheap check runs first.
    """
    if used > settings.tree_cap:
        return "its processes reached %s, over the %s limit (LOADGUARD_TREE_CAP_GB)" % (
            fmt_gb(used),
            fmt_gb(settings.tree_cap),
        )
    if used < PANIC_MIN_SHARE * settings.total:
        return None
    available = read_available()
    if available >= settings.panic_free_pct or not is_largest():
        return None
    return (
        "the machine fell to %.0f%% free memory while this command held %s, "
        "the most of any guarded command (largest apps: %s)" % (available, fmt_gb(used), largest_apps())
    )


def cmd_run(args):
    max_wait = DEFAULT_MAX_WAIT_SECONDS
    while args and args[0] != "--":
        if args[0] == "--max-wait" and len(args) > 1:
            try:
                max_wait = float(args[1])
            except ValueError:
                fail("--max-wait %r is not a number of seconds" % args[1])
            args = args[2:]
        else:
            fail("usage: loadguard run [--max-wait SECONDS] -- COMMAND [ARGS...]")
    command = args[1:]
    if not command:
        fail("usage: loadguard run [--max-wait SECONDS] -- COMMAND [ARGS...]")

    if os.environ.get(ACTIVE_ENV):
        # Already inside a guarded tree: the outer run holds the slot and watches us.
        try:
            os.execvp(command[0], command)
        except OSError as error:
            fail("cannot run %s: %s" % (command[0], error), 127)

    settings = Settings()
    command_text = " ".join(shlex.quote(part) for part in command)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, _on_signal)

    child = None
    tree = None
    killed_reason = None
    slot_path = None
    try:
        index, _lease = wait_for_slot(settings, command_text, max_wait)
        slot_path = settings.path("slot-%d.json" % index)
        started = time.time()
        record = {"pid": os.getpid(), "command": command_text, "cwd": os.getcwd(), "started": started}
        write_json(slot_path, dict(record, tree_bytes=0, peak_bytes=0))
        env = dict(os.environ)
        env[ACTIVE_ENV] = "1"
        try:
            child = subprocess.Popen(command, env=env, preexec_fn=os.setpgrp)
        except OSError as error:
            fail("cannot run %s: %s" % (command[0], error), 127)
        tree = Tree(child.pid)
        peak = 0
        while True:
            try:
                child.wait(timeout=POLL_SECONDS)
                break
            except subprocess.TimeoutExpired:
                pass
            tree.refresh()
            used = tree.memory()
            peak = max(peak, used)
            write_json(slot_path, dict(record, tree_bytes=used, peak_bytes=peak))
            killed_reason = kill_reason(
                settings, used, available_percent, lambda: largest_guarded(settings, used)
            )
            if killed_reason:
                tree.kill()
                child.wait()
                fail(
                    "stopped `%s` — %s. Do not retry it unchanged: run a narrower scope "
                    "(fewer workers, one package or test file) or wait for other work "
                    "(`loadguard status`)." % (command_text, killed_reason),
                    EXIT_KILLED,
                )
    except Stop as stop:
        if tree is not None:
            tree.kill()
        sys.exit(128 + stop.args[0])
    finally:
        if tree is not None and not killed_reason:
            tree.refresh()
            leftovers = len(tree.members)
            if leftovers:
                tree.kill()
                sys.stderr.write(
                    "loadguard: stopped %d process(es) `%s` left running after it exited\n"
                    % (leftovers, command_text)
                )
        if slot_path:
            try:
                os.unlink(slot_path)
            except OSError:
                pass

    code = child.returncode
    return 128 - code if code < 0 else code


# ---------------------------------------------------------------------- status


def cmd_status(_args):
    settings = Settings()
    print(
        "memory: %.0f%% available of %s · new runs start at ≥%.0f%% · per-command limit %s"
        % (available_percent(), fmt_gb(settings.total), settings.min_free_pct, fmt_gb(settings.tree_cap))
    )
    holders = {r["pid"]: r for r in read_records(settings, "slot-")}
    print("slots (%d):" % settings.slots)
    for index in range(settings.slots):
        path = settings.path("slot-%d.json" % index)
        record = None
        try:
            with open(path) as handle:
                record = holders.get(json.load(handle)["pid"])
        except (OSError, ValueError, KeyError):
            pass
        if record:
            print(
                "  [%d] pid %d  %s now, peak %s  %s  %s  (%s)"
                % (
                    index,
                    record["pid"],
                    fmt_gb(record.get("tree_bytes", 0)),
                    fmt_gb(record.get("peak_bytes", 0)),
                    fmt_duration(time.time() - record["started"]),
                    record["command"],
                    record["cwd"],
                )
            )
        else:
            print("  [%d] free" % index)
    waiters = read_records(settings, "wait-")
    print("waiting: %d" % len(waiters))
    for record in waiters:
        print(
            "  pid %d  %s  %s  (%s)"
            % (record["pid"], fmt_duration(time.time() - record["started"]), record["command"], record["cwd"])
        )
    print("largest apps: %s" % largest_apps())
    return 0


# ------------------------------------------------------------- heavy commands

_WRAPPERS = {"time", "nice", "env", "exec", "command", "nohup", "caffeinate", "stdbuf"}
_SHELLS = {"sh", "bash", "zsh", "dash"}
_ALWAYS_HEAVY = {
    "pytest", "py.test", "jest", "vitest", "mocha", "ava", "tsc", "vue-tsc",
    "xcodebuild", "gradle", "gradlew", "mvn", "mvnw", "webpack", "rspack", "tox", "nox",
}
_SUBCOMMAND_HEAVY = {
    "cargo": {"build", "test", "nextest", "bench", "clippy", "check"},
    "go": {"build", "test"},
    "swift": {"build", "test"},
    "dotnet": {"build", "test"},
    "bazel": {"build", "test"},
    "bazelisk": {"build", "test"},
    "playwright": {"test"},
    "cypress": {"run"},
    "next": {"build"},
    "vite": {"build"},
    "nuxt": {"build"},
    "astro": {"build"},
}
_PACKAGE_MANAGERS = {"npm", "pnpm", "yarn", "bun"}
_SCRIPT_RE = re.compile(r"(^|[:_-])(test|tests|build|typecheck|type-check|e2e|check|all)($|[:_-])")
_INFO_FLAGS = {"--version", "-v", "-V", "--help", "-h"}
_ASSIGNMENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
_LEADING_ASSIGNMENTS_RE = re.compile(
    r"\s*\(?\s*(?:[A-Za-z_][A-Za-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|\S*)\s+)*"
)


def split_segments(command):
    """(start, end) spans of the simple commands in a shell line.

    Splits on control operators outside quotes, skips comments and heredoc
    bodies, so `git commit -m "npm test; fix"` stays one segment.
    """
    spans = []
    start = i = 0
    quote = None
    pending_heredocs = []
    n = len(command)
    while i < n:
        c = command[i]
        if quote:
            if c == "\\" and quote == '"':
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c == "\\":
            i += 2
            continue
        if c in "'\"":
            quote = c
            i += 1
            continue
        if c == "#" and (i == 0 or command[i - 1].isspace()):
            spans.append((start, i))
            end = command.find("\n", i)
            i = start = n if end < 0 else end
            continue
        if command.startswith("<<", i) and not command.startswith("<<<", i):
            match = re.match(r"<<-?\s*(['\"]?)([A-Za-z0-9_]+)\1", command[i:])
            if match:
                pending_heredocs.append(match.group(2))
                i += match.end()
                continue
        if c == "\n" and pending_heredocs:
            spans.append((start, i))
            for delimiter in pending_heredocs:
                while i < n:
                    end = command.find("\n", i + 1)
                    line = command[i + 1 : n if end < 0 else end]
                    i = n if end < 0 else end
                    if line.strip() == delimiter:
                        break
            pending_heredocs = []
            start = i
            continue
        width = 2 if command.startswith(("&&", "||"), i) else (1 if c in ";|&\n()" else 0)
        if width:
            spans.append((start, i))
            i += width
            start = i
            continue
        i += 1
    spans.append((start, n))
    return [(a, b) for a, b in spans if command[a:b].strip()]


def _strip_options(argv):
    while argv and (argv[0].startswith("-") or argv[0].isdigit()):
        argv = argv[1:]
    return argv


def core_argv(tokens):
    """The program a segment really runs, past env assignments, wrappers and runners."""
    argv = list(tokens)
    while argv:
        head = os.path.basename(argv[0])
        if _ASSIGNMENT_RE.match(argv[0]):
            argv = argv[1:]
        elif head in _WRAPPERS:
            argv = _strip_options(argv[1:])
        elif head in {"uv", "poetry", "pipenv", "pdm", "hatch", "rye"} and argv[1:2] == ["run"]:
            argv = _strip_options(argv[2:])
        elif head in {"npx", "bunx", "pnpx"}:
            argv = _strip_options(argv[1:])
        elif head in {"pnpm", "yarn"} and argv[1:2] in (["exec"], ["dlx"]):
            argv = _strip_options(argv[2:])
        elif re.fullmatch(r"python[0-9.]*", head) and argv[1:2] == ["-m"] and len(argv) > 2:
            argv = argv[2:]
        else:
            return argv
    return argv


def heavy_label(argv):
    """A short name for argv if it is a heavy command, else None."""
    if not argv:
        return None
    head = os.path.basename(argv[0])
    rest = argv[1:]
    if head == "loadguard" or _INFO_FLAGS.intersection(rest):
        return None
    words = [a for a in rest if not a.startswith("-")]
    sub = words[0] if words else ""
    extra = os.environ.get("LOADGUARD_EXTRA_PATTERN")
    if extra and re.search(extra, " ".join(argv)):
        return " ".join(argv[:2])
    if head in _SHELLS and "-c" in rest:
        script = rest[rest.index("-c") + 1] if rest.index("-c") + 1 < len(rest) else ""
        found = find_heavy(script)
        return found[0][2] if found else None
    if head in _ALWAYS_HEAVY:
        return head
    if sub in _SUBCOMMAND_HEAVY.get(head, ()):
        return "%s %s" % (head, sub)
    if head in _PACKAGE_MANAGERS:
        if sub in {"test", "t", "tst"}:
            return "%s test" % head
        if sub in {"run", "run-script"} and len(words) > 1 and _SCRIPT_RE.search(words[1]):
            return "%s run %s" % (head, words[1])
        if head != "npm" and _SCRIPT_RE.search(sub):
            return "%s %s" % (head, sub)
        return None
    if head == "docker":
        if sub == "build" or (sub in {"buildx", "compose", "builder"} and "build" in words):
            return "docker build"
        if sub == "compose" and "up" in words and "--build" in rest:
            return "docker compose up --build"
        return None
    if head == "make":
        targets = [w for w in words if "=" not in w]
        if not targets or any(_SCRIPT_RE.search(t) for t in targets):
            return "make %s" % " ".join(targets) if targets else "make"
        return None
    if head == "node" and "--test" in rest:
        return "node --test"
    return None


def find_heavy(command):
    """[(start, end, label)] for each heavy simple command in a shell line."""
    hits = []
    for start, end in split_segments(command):
        segment = command[start:end]
        try:
            tokens = shlex.split(segment, comments=False, posix=True)
        except ValueError:
            tokens = segment.split()
        label = heavy_label(core_argv(tokens))
        if label:
            hits.append((start, end, label))
    return hits


def guarded_suggestion(command, hits, program="loadguard"):
    prefix = "%s run -- " % program
    out = command
    for start, end, _ in sorted(hits, reverse=True):
        offset = _LEADING_ASSIGNMENTS_RE.match(command, start, end).end()
        out = out[:offset] + prefix + out[offset:]
    return out


def _program_name():
    me = os.path.realpath(sys.argv[0])
    found = shutil.which("loadguard")
    if found and os.path.realpath(found) == me:
        return "loadguard"
    return shlex.quote(me)


def cmd_check(args):
    command = " ".join(args)
    hits = find_heavy(command)
    if not hits:
        print("light: runs as is")
        return 1
    print("heavy: %s" % ", ".join(label for _, _, label in hits))
    print(guarded_suggestion(command, hits, _program_name()))
    return 0


def cmd_hook(_args):
    try:
        if os.environ.get("LOADGUARD_HOOK", "").strip().lower() in {"0", "off", "false", "no"}:
            return 0
        payload = json.load(sys.stdin)
        if payload.get("tool_name") != "Bash":
            return 0
        command = (payload.get("tool_input") or {}).get("command") or ""
        hits = find_heavy(command)
        if not hits:
            return 0
        labels = ", ".join(sorted({label for _, _, label in hits}))
        reason = (
            "loadguard: several agents share this machine's memory, and `%s` can take many GB. "
            "Run it through loadguard so it waits for a free slot and is stopped (with everything "
            "it spawned) before it can exhaust RAM:\n\n%s\n\n"
            "It may wait in a queue first, so prefer running it in the background. "
            "`loadguard status` shows what is running and waiting."
            % (labels, guarded_suggestion(command, hits, _program_name()))
        )
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            },
            sys.stdout,
        )
    except Exception:  # noqa: BLE001 — a broken guard must never block the agent's shell
        return 0
    return 0


COMMANDS = {"run": cmd_run, "status": cmd_status, "check": cmd_check, "hook": cmd_hook}


def main(argv):
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    if argv[0] in {"-V", "--version"}:
        print("loadguard %s" % VERSION)
        return 0
    handler = COMMANDS.get(argv[0])
    if handler is None:
        fail("unknown command %r (try: %s)" % (argv[0], ", ".join(COMMANDS)))
    return handler(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
